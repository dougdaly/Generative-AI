{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supply_plan_v1.json",
  "type": "object",
  "required": ["type", "component_sources", "assembly_country", "ship_mode"],
  "properties": {
    "type": { "const": "supply.plan:v1" },

    "component_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "country"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3,
            "pattern": "^[A-Z]{2,3}$"
          }
        },
        "additionalProperties": false
      }
    },

    "assembly_country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3,
      "pattern": "^[A-Z]{2,3}$"
    },

    "ship_mode": { "type": "string", "enum": ["SEA", "AIR", "GROUND"] }
  },
  "additionalProperties": false
}

